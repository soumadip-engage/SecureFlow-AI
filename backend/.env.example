# Copy to backend/.env locally. Never commit actual credentials or keys.
MONGODB_URI=mongodb+srv://REPLACE_WITH_LOCAL_CREDENTIALS
MONGODB_DB=SecureFlowDB

# Separate, server-side admin key; do not put it in frontend VITE_ variables.
ADMIN_API_KEY=
APP_ENV=development
ENABLE_DEMO_RESET=false

# Training can be expensive; opt in only after checking data labels.
AUTO_TRAIN_ML=false
ML_MODEL_PATH=
ML_MAX_ROWS=100000
ML_TREES=180
